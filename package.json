{
  "name": "phish-or-legit",
  "private": true,
  "version": "1.0.0",
  "description": "A swipe game that trains you to spot phishing emails and scam texts.",
  "type": "module",
  "scripts": {
    "feed": "node scripts/fetch-openphish.mjs",
    "predev": "npm run feed",
